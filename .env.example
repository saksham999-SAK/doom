# Public Supabase Credentials (Safe for Browser)
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Next.js / Vercel compatibility aliases
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SERVER-ONLY SECRET KEY (Must NEVER have VITE_ or NEXT_PUBLIC_ prefix!)
# Get from Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
